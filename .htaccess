Options -Indexes -MultiViews
RewriteEngine On

# Forward Authorization header on CGI/FastCGI hosts like Namecheap
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Allow Namecheap AutoSSL / Let's Encrypt certificate verification
RewriteRule ^\.well-known/ - [L]

# Allow the app entry point, built assets, and the JSON API.
RewriteRule ^(?:index\.html)?$ dist/index.html [L]
RewriteRule ^assets/([A-Za-z0-9_.-]+)$ dist/assets/$1 [L]
RewriteRule ^(?:dist/index\.html|dist/assets/[A-Za-z0-9_.-]+|api/index\.php)$ - [L]
RewriteRule ^ - [F,L]

<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
